@model Cyberpilot.Web.Models.PipelineAdminDefinitionEditViewModel

<section data-wizard-step-panel="2" class="wizard-panel">
    <div class="telemetry-panel">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <div>
                <p class="eyebrow">Pipeline Structure</p>
                <h2 class="h5 mb-0">Stages</h2>
            </div>
            <button class="btn btn-outline-info btn-sm" type="button" data-add-stage>Add stage</button>
        </div>
        <div class="d-grid gap-3" data-stage-list>
            @for (var index = 0; index < Model.Stages.Count; index++)
            {
                <partial name="_PipelineStageEditor" model="(Model.Stages[index], index)" />
            }
        </div>
        <span class="text-danger small" asp-validation-for="Stages"></span>
    </div>
</section>
