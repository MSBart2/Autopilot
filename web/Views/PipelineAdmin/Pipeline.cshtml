@model Cyberpilot.Web.Models.PipelineAdminDefinitionEditViewModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.OriginalName) ? "New Pipeline" : $"Edit {Model.Name}";
}

<section class="guide-viewport" aria-labelledby="pipeline-editor-title">
    <aside class="guide-rail">
        <p class="eyebrow">Admin</p>
        <h1 id="pipeline-editor-title">Pipeline Editor</h1>
        <p class="rail-summary">Define pipeline metadata, ordered stages, stage gates, required artifacts, and transitions.</p>
        <a class="btn btn-outline-info btn-sm" asp-action="Index">Back to admin</a>
    </aside>

    <div class="guide-content-wrap">
        <form asp-action="SavePipeline" method="post" class="d-grid gap-3" id="pipeline-editor-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="OriginalName" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <section class="telemetry-panel">
                <p class="eyebrow">Definition</p>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" asp-for="Name"></label>
                        <input class="form-control" asp-for="Name" />
                        <span class="text-danger small" asp-validation-for="Name"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" asp-for="Version"></label>
                        <input class="form-control" asp-for="Version" />
                        <span class="text-danger small" asp-validation-for="Version"></span>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label" asp-for="PolicyProfileName">Policy profile</label>
                        <select class="form-select" asp-for="PolicyProfileName">
                            @foreach (var policy in Model.PolicyProfiles)
                            {
                                <option value="@policy.Name">@policy.Name (@policy.Strictness)</option>
                            }
                        </select>
                        <span class="text-danger small" asp-validation-for="PolicyProfileName"></span>
                    </div>
                </div>
            </section>

            <section class="telemetry-panel">
                <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                    <div>
                        <p class="eyebrow">Stages</p>
                        <h2 class="h5 mb-0">Execution Order</h2>
                    </div>
                    <button class="btn btn-outline-info btn-sm" type="button" data-add-stage>Add stage</button>
                </div>
                <div class="d-grid gap-3" data-stage-list>
                    @for (var index = 0; index < Model.Stages.Count; index++)
                    {
                        <partial name="_PipelineStageEditor" model="(Model.Stages[index], index)" />
                    }
                </div>
            </section>

            <section class="telemetry-panel">
                <p class="eyebrow">Transitions</p>
                <label class="form-label" asp-for="TransitionsText">Transitions</label>
                <textarea class="form-control font-monospace" asp-for="TransitionsText" rows="5" placeholder="triage|plan|go&#10;plan|implement|go"></textarea>
                <div class="form-text text-secondary">Use one transition per line: fromStage|toStage|condition. Leave blank to auto-link stages in order with condition "go".</div>
                <span class="text-danger small" asp-validation-for="TransitionsText"></span>
            </section>

            <div class="d-flex gap-2 justify-content-end">
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                <button class="btn btn-primary" type="submit">Save pipeline</button>
            </div>
        </form>
    </div>
</section>

<template id="stage-template">
    <partial name="_PipelineStageEditor" model="(new Cyberpilot.Web.Models.PipelineAdminStageInputModel(), -1)" />
</template>

@section Scripts {
    <script src="~/js/pipeline-admin.js" asp-append-version="true"></script>
}
