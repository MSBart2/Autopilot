@model Cyberpilot.Web.Models.PipelineAdminDefinitionEditViewModel
@using Cyberpilot.Web.Models
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.OriginalName) ? "New Pipeline" : $"Edit {Model.Name}";

    var ms = ViewData.ModelState;
    var steps = new List<PipelineWizardStepModel>
    {
        new(1, "Basics",      "Name, version, policy",   ms.Keys.Any(k => (k == nameof(Model.Name) || k == nameof(Model.Version) || k == nameof(Model.PolicyProfileName)) && ms[k]!.Errors.Count > 0)),
        new(2, "Stages",      "Execution order",         ms.Keys.Any(k => k.StartsWith("Stages[") && !k.EndsWith(".GatesText") && ms[k]!.Errors.Count > 0)),
        new(3, "Gates",       "Quality checks",          ms.Keys.Any(k => k.EndsWith(".GatesText") && ms[k]!.Errors.Count > 0)),
        new(4, "Transitions", "Stage connections",       ms.Keys.Any(k => k == nameof(Model.TransitionsText) && ms[k]!.Errors.Count > 0)),
        new(5, "Review",      "Confirm and save",        false),
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pipeline-wizard.css" asp-append-version="true" />
}

<section class="guide-viewport" aria-labelledby="pipeline-editor-title">
    <aside class="guide-rail">
        <p class="eyebrow">Admin</p>
        <h1 id="pipeline-editor-title">Pipeline Editor</h1>
        <p class="rail-summary">Guided wizard: define metadata, stages, gates, transitions, then review before saving.</p>
        <a class="btn btn-outline-info btn-sm" asp-action="Index">Back to admin</a>
    </aside>

    <div class="guide-content-wrap">
        <partial name="_WizardStepMap" model="steps" />

        <form asp-action="SavePipeline" method="post" class="d-grid gap-3" id="pipeline-editor-form"
              data-wizard-form data-wizard-active-step="@Model.WizardActiveStep">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="OriginalName" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <partial name="_WizardStep_Basics"      model="Model" />
            <partial name="_WizardStep_Stages"      model="Model" />
            <partial name="_WizardStep_Gates"       model="Model" />
            <partial name="_WizardStep_Transitions" model="Model" />
            <partial name="_WizardStep_Review"      model="Model" />

            <div class="wizard-nav d-flex justify-content-between align-items-center gap-2">
                <button class="btn btn-outline-secondary" type="button" data-wizard-prev>Previous</button>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-info" type="button" data-wizard-next>Next</button>
                    <button class="btn btn-primary wizard-save-btn" type="submit">Save pipeline</button>
                </div>
            </div>
        </form>
    </div>
</section>

<template id="stage-template">
    <partial name="_PipelineStageEditor" model="(new Cyberpilot.Web.Models.PipelineAdminStageInputModel(), -1)" />
</template>

@section Scripts {
    <script src="~/js/pipeline-wizard.js" asp-append-version="true"></script>
    <script src="~/js/pipeline-admin.js" asp-append-version="true"></script>
}
