@model Cyberpilot.Web.Models.PipelineRunDetailsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = $"Run — Issue #{Model.Run.IssueNumber}";
    var isActive = Model.Run.Status is "Queued" or "Running" or "Pausing";
    var isAwaitingCopilot = Model.Run.Status == "AwaitingCopilot";
    var statusClass = Model.Run.Status switch
    {
        "Completed" => "text-bg-success",
        "Failed" => "text-bg-danger",
        "Running" => "text-bg-primary",
        "Pausing" => "text-bg-info awaiting-pulse",
        "Paused" => "text-bg-warning text-dark",
        "Stopped" => "text-bg-warning text-dark",
        "Cancelled" => "text-bg-warning",
        "AwaitingCopilot" => "text-bg-info awaiting-pulse",
        _ => "text-bg-secondary"
    };
    var elapsed = Model.Run.CompletedAt.HasValue
        ? Model.Run.CompletedAt.Value - Model.Run.CreatedAt
        : DateTime.UtcNow - Model.Run.CreatedAt;
    var elapsedStr = elapsed.TotalHours >= 1
        ? elapsed.ToString(@"h\:mm\:ss")
        : elapsed.ToString(@"m\:ss");
    var displayRepo = Model.Run.Repository;
    var ghIssueUrl = !string.IsNullOrWhiteSpace(Model.Run.IssueUrl)
        ? Model.Run.IssueUrl
        : $"https://github.com/{displayRepo}/issues/{Model.Run.IssueNumber}";
    var issueTitle = string.IsNullOrWhiteSpace(Model.Issue?.Title) ? $"Issue #{Model.Run.IssueNumber}" : Model.Issue.Title;
    var issueBody = Model.Issue?.Body?.Trim() ?? string.Empty;
    var runIsActive = Model.Run.Status is "Queued" or "Running" or "Pausing";
    var isDelivered = Model.Run.Status == "Completed" && !Model.Run.SkipDeliver;
    var stopDiagnostic = Model.StopDiagnostic;
    var canContinue = Model.CanContinue;
    var canReworkFromReview = Model.CanReworkFromReview;
    var maxStageRetries = Model.MaxStageRetries;
    var planReview = Model.PlanReview;
    var bootstrapJson = JsonSerializer.Serialize(new
    {
        runId = Model.Run.Id,
        runIsActive,
        runIsRemote = Model.Run.IsRemote,
        maxStageRetries,
        currentRunStatus = Model.Run.Status,
        runStartUtc = DateTime.SpecifyKind(Model.Run.CreatedAt, DateTimeKind.Utc).ToString("o"),
        canReworkFromReview,
        logs = Model.Logs.Select(l => new
        {
            stage = l.StageName,
            status = l.Status ?? "unknown",
            output = l.Output ?? string.Empty,
            duration = l.CompletedAt.HasValue ? (int)(l.CompletedAt.Value - l.StartedAt).TotalSeconds : 0,
            timestamp = l.StartedAt.ToString("o"),
            inputTokens = l.InputTokens,
            outputTokens = l.OutputTokens,
            estimatedCostUsd = l.EstimatedCostUsd,
            model = l.Model,
            turnCount = l.TurnCount,
            toolCallCount = l.ToolCallCount,
            failedToolCallCount = l.FailedToolCallCount,
            sessionErrorCount = l.SessionErrorCount,
            durationMs = l.DurationMs,
            retryCount = l.RetryCount,
            retryReason = l.RetryReason,
        }),
        dispatches = (Model.Dispatches ?? []).Select(d => new
        {
            type = d.Type,
            message = d.Message,
            timestamp = d.CreatedAt.ToString("o"),
        })
    });
}

@* Breadcrumb *@
<nav aria-label="breadcrumb" class="mb-3 app-breadcrumb command-breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">Runs</a></li>
        <li class="breadcrumb-item"><a asp-action="Issues">Issues</a></li>
        <li class="breadcrumb-item active">Issue #@Model.Run.IssueNumber</li>
    </ol>
</nav>

@if (TempData["PipelineNotice"] is string notice)
{
    <div class="alert alert-info" role="alert">@notice</div>
}

@if (TempData["PipelineError"] is string pipelineError)
{
    <div class="alert alert-warning" role="alert">@pipelineError</div>
}

<header class="run-command-bar" id="run-command-bar">
    <div class="run-bar-identity">
        <p class="eyebrow">Mission @Model.Run.IssueNumber</p>
        <h1 class="run-bar-title">Run Room</h1>
    </div>
    <div class="run-bar-stats">
        <div class="run-bar-stat">
            <span class="run-bar-stat-value" id="run-elapsed">@elapsedStr</span>
            <small>elapsed</small>
        </div>
        <div class="run-bar-stat">
            <span class="badge @statusClass" id="run-status-badge">
                @if (Model.Run.Status == "Running")
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"
                          id="run-spinner"></span>
                }
                <span id="run-status">@Model.Run.Status</span>
            </span>
        </div>
    </div>
    <div class="run-bar-actions" id="run-bar-actions">
        <a href="@ghIssueUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-info">Issue
            #@Model.Run.IssueNumber ↗</a>
            @if (!string.IsNullOrWhiteSpace(Model.Run.PrUrl))
            {
                <a href="@Model.Run.PrUrl" class="btn btn-sm btn-primary" target="_blank" rel="noopener" id="pr-link-live">View
                    PR</a>
                }
                @if (isAwaitingCopilot)
                {
                    <form asp-action="ResumeReview" asp-route-id="@Model.Run.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-success"
                                title="Copilot agent working — resume when PR is ready">▶ Resume Review</button>
                    </form>
                }
                @if (!isActive && !isAwaitingCopilot && canContinue)
                {
                    @if (canReworkFromReview)
                    {
                        <form asp-action="ReworkFromReview" asp-route-id="@Model.Run.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-success"
                                    title="Send review findings back to implementation on the existing PR branch">
                                Rework from Review
                            </button>
                        </form>
                    }
                    <form asp-action="Continue" asp-route-id="@Model.Run.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-primary">
                            @(Model.Run.Status == "Paused" ? "▶ Resume" : canReworkFromReview ? "Retry Review" : "Continue")
                        </button>
                    </form>
                }
                @if (!isActive && !isDelivered && !Model.Run.IsRemote)
                {
                    <form asp-action="ResetMission" asp-route-id="@Model.Run.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Reset</button>
                    </form>
                }
                @if (!isActive && !isDelivered && !Model.Run.IsRemote && !Model.Run.BenchmarkResetAt.HasValue)
                {
                    <form asp-action="BenchmarkReset" asp-route-id="@Model.Run.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-warning" title="Clean up remote state (PR, branch, comments) while keeping run metrics in the database.">⚗ Benchmark Reset</button>
                    </form>
                }
                @if (Model.Run.BenchmarkResetAt.HasValue)
                {
                    <span class="badge text-bg-secondary" title="Remote state was cleaned for re-run at @Model.Run.BenchmarkResetAt.Value.ToString("u")">⚗ Benchmark Reset</span>
                }
                @if (!isActive && !isDelivered && !Model.Run.IsRemote && canContinue)
                {
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse"
                            data-bs-target="#resume-stage-panel" aria-expanded="false" aria-controls="resume-stage-panel">
                        ↩ Resume From Stage
                    </button>
                }
                @if (isActive)
                {
                    <span id="cancel-section" class="d-inline-flex gap-1">
                        <form asp-action="Pause" asp-route-id="@Model.Run.Id" method="post" class="d-inline" id="pause-form"
                              style="@(Model.Run.Status == "Pausing" ? "display:none" : "")">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-warning" id="pause-btn">⏸ Pause</button>
                        </form>
                        <form asp-action="Cancel" asp-route-id="@Model.Run.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                        </form>
                    </span>
                }
            </div>
        </header>

        @if (!isActive && !isDelivered && !Model.Run.IsRemote && canContinue)
        {
            <div class="collapse" id="resume-stage-panel">
                <div class="resume-stage-panel mb-3">
                    <h5 class="resume-stage-title">↩ Resume From Stage</h5>
                    <p class="resume-stage-desc text-muted small">Pick any stage to restart from. Optional overrides apply to this
                        attempt only.</p>
                        <form asp-action="RetryStage" asp-route-id="@Model.Run.Id" method="post"
                              class="resume-stage-form d-flex flex-wrap gap-2 align-items-end">
                            @Html.AntiForgeryToken()
                            <div>
                                <label class="form-label form-label-sm mb-1">Stage</label>
                                <select name="StageName" class="form-select form-select-sm" style="min-width:130px">
                                    @foreach (var stage in Cyberpilot.Web.Models.PipelineRunDetailsViewModel.ValidStageNames)
                                    {
                                        <option value="@stage">@(char.ToUpperInvariant(stage[0]) + stage[1..])</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="form-label form-label-sm mb-1">Model override <small
                                    class="text-muted">(optional)</small></label>
                                    <input name="Model" type="text" class="form-control form-control-sm"
                                           placeholder="leave blank to keep @Model.Run.Model" style="min-width:220px" />
                                </div>
                                <div>
                                    <label class="form-label form-label-sm mb-1">Timeout (min) <small
                                        class="text-muted">(optional)</small></label>
                                        <input name="StageTimeoutMinutes" type="number" class="form-control form-control-sm" min="1" max="120"
                                               placeholder="@Model.Run.StageTimeoutMinutes" style="width:100px" />
                                    </div>
                                    <div class="flex-grow-1">
                                        <label class="form-label form-label-sm mb-1">Reason <small class="text-muted">(optional)</small></label>
                                        <input name="RetryReason" type="text" class="form-control form-control-sm" maxlength="500"
                                               placeholder="what changed or needs another attempt" />
                                    </div>
                                    <button type="submit" class="btn btn-sm btn-primary">↩ Retry Stage</button>
                                </form>
                            </div>
                        </div>
                    }

                    <section class="command-surface run-surface">
                        <div class="run-telemetry-grid">
                            <div class="stat-card">
                                <div class="stat-label">Model</div>
                                <strong class="text-truncate d-block" title="@Model.Run.Model">@Model.Run.Model</strong>
                            </div>
                            <div class="stat-card">
                                <div class="stat-label">Definition</div>
                                <strong class="text-truncate d-block"
                                        title="@Model.PipelineDefinitionLabel">@Model.PipelineDefinitionLabel</strong>
                                <small class="muted-cell">@Model.PolicyProfileLabel / contract @Model.ContractVersionLabel</small>
                            </div>
                            <div class="stat-card">
                                <div class="stat-label">Branch</div>
                                @if (!string.IsNullOrWhiteSpace(Model.Run.BranchName))
                                {
                                    <code class="small" id="branch-value">@Model.Run.BranchName</code>
                                }
                                else
                                {
                                    <span class="muted-cell fst-italic" id="branch-value">pending</span>
                                }
                            </div>
                            <div class="stat-card">
                                <div class="stat-label">Started</div>
                                <strong>@Model.Run.CreatedAt.ToLocalTime().ToString("g")</strong>
                            </div>
                            <div class="stat-card">
                                <div class="stat-label">Tokens</div>
                                @if (Model.TotalInputTokens > 0 || Model.TotalOutputTokens > 0)
                                {
                                    <strong id="total-tokens-value">@Model.TotalInputTokens.ToString("N0") in /
                                        @Model.TotalOutputTokens.ToString("N0") out</strong>
                                    }
                else
                                    {
                                        <span class="muted-cell fst-italic" id="total-tokens-value">—</span>
                                    }
                                </div>
                                <div class="stat-card">
                                    <div class="stat-label">Est. Cost</div>
                                    @if (Model.TotalEstimatedCostUsd.HasValue)
                                    {
                                        <strong id="total-cost-value">@Model.TotalEstimatedCostUsd.Value.ToString("$0.0000")</strong>
                                    }
                                    else
                                    {
                                        <span class="muted-cell fst-italic" id="total-cost-value">—</span>
                                    }
                                </div>
                                <div class="stat-card">
                                    <div class="stat-label">Turns / Tools</div>
                                    @if (Model.TotalTurnCount > 0 || Model.TotalToolCallCount > 0)
                                    {
                                        <strong>@Model.TotalTurnCount.ToString("N0") turns / @Model.TotalToolCallCount.ToString("N0") tools</strong>
                                        @if (Model.TotalFailedToolCallCount > 0)
                                        {
                                            <small class="muted-cell">@Model.TotalFailedToolCallCount.ToString("N0") failed tool calls</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="muted-cell fst-italic">—</span>
                                    }
                                </div>
                                <div class="stat-card">
                                    <div class="stat-label">Model Time</div>
                                    @if (Model.TotalModelDuration.HasValue)
                                    {
                                        <strong>@Model.TotalModelDuration.Value.ToString(@"m\:ss")</strong>
                                    }
                                    else
                                    {
                                        <span class="muted-cell fst-italic">—</span>
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.Run.Error))
                            {
                                <div class="alert alert-danger d-flex gap-2" role="alert">
                                    <span class="flex-shrink-0">!</span>
                                    <div><strong>Diagnostic:</strong> @Model.Run.Error</div>
                                </div>
                            }

                             @if (stopDiagnostic is not null)
                             {
                                 <div class="alert alert-@stopDiagnostic.Severity stop-diagnostic" role="alert" id="stop-diagnostic">
                                    <div class="stop-diagnostic-header">
                                        <strong>@stopDiagnostic.Title</strong>
                                        <span>Action required before this run can continue.</span>
                                    </div>
                                    <p class="stop-diagnostic-reason">@stopDiagnostic.Reason</p>
                                    <div class="stop-diagnostic-actions">
                                        <span class="stop-diagnostic-label">Corrective actions</span>
                                        <ul>
                                            @foreach (var action in stopDiagnostic.CorrectiveActions)
                                            {
                                                <li>@action</li>
                                            }
                                        </ul>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(stopDiagnostic.Evidence))
                                    {
                                        <small class="stop-diagnostic-evidence">@stopDiagnostic.Evidence</small>
                                     }
                                 </div>
                             }

                             @if (planReview is not null)
                             {
                                 <section class="plan-review-panel" aria-labelledby="plan-review-title">
                                     <div class="plan-review-header">
                                         <div>
                                             <p class="eyebrow">Plan artifact</p>
                                             <h3 id="plan-review-title">Plan Review</h3>
                                         </div>
                                         <div class="plan-review-badges">
                                             <span class="plan-review-status">@planReview.Status</span>
                                             @if (!string.IsNullOrWhiteSpace(planReview.Decision) && planReview.Decision != "unknown")
                                             {
                                                 <span class="plan-review-decision">@planReview.Decision</span>
                                             }
                                         </div>
                                     </div>
                                     <div class="plan-review-body">
                                         <div class="plan-review-summary">
                                             <span class="plan-review-label">Summary</span>
                                             <p>@planReview.Summary</p>
                                         </div>
                                         <dl class="plan-review-meta">
                                             <div>
                                                 <dt>Branch</dt>
                                                 <dd>
                                                     @if (planReview.HasBranch)
                                                     {
                                                         <code>@planReview.BranchName</code>
                                                     }
                                                     else
                                                     {
                                                         <span class="muted-cell fst-italic">pending</span>
                                                     }
                                                 </dd>
                                             </div>
                                             <div>
                                                 <dt>Captured</dt>
                                                 <dd>@planReview.CreatedAt.ToLocalTime().ToString("g")</dd>
                                             </div>
                                             <div>
                                                 <dt>Contract</dt>
                                                 <dd>@(string.IsNullOrWhiteSpace(planReview.ContractVersion) ? "unknown" : planReview.ContractVersion)</dd>
                                             </div>
                                         </dl>

                                         @if (planReview.HasRequiredActions)
                                         {
                                             <div class="plan-review-actions">
                                                 <span class="plan-review-label">Required before continuing</span>
                                                 <ul>
                                                     @foreach (var action in planReview.RequiredActions)
                                                     {
                                                         <li>@action</li>
                                                     }
                                                 </ul>
                                             </div>
                                         }

                                         @if (planReview.HasArtifacts)
                                         {
                                             <div class="plan-review-artifacts" aria-label="Plan artifacts">
                                                 @foreach (var artifact in planReview.Artifacts)
                                                 {
                                                     <article class="plan-review-artifact">
                                                         <div class="plan-review-artifact-header">
                                                             <h4>@artifact.Label</h4>
                                                             @if (!string.IsNullOrWhiteSpace(artifact.MediaType))
                                                             {
                                                                 <span>@artifact.MediaType</span>
                                                             }
                                                         </div>
                                                         @if (artifact.HasValue)
                                                         {
                                                             <p>@artifact.Value</p>
                                                         }
                                                         @if (artifact.HasUri)
                                                         {
                                                             <a href="@artifact.Uri" target="_blank" rel="noopener">Open artifact</a>
                                                         }
                                                     </article>
                                                 }
                                             </div>
                                         }

                                         @if (planReview.HasEvidence)
                                         {
                                             <div class="plan-review-evidence">
                                                 <span class="plan-review-label">Supporting evidence</span>
                                                 @foreach (var evidence in planReview.Evidence)
                                                 {
                                                     <p><strong>@evidence.KindLabel:</strong> @evidence.Summary</p>
                                                 }
                                             </div>
                                         }

                                         @if (planReview.HasFullPlanText)
                                         {
                                             <details class="plan-review-full">
                                                 <summary>Open full plan text</summary>
                                                 <pre>@planReview.FullPlanText</pre>
                                             </details>
                                         }
                                     </div>
                                 </section>
                             }
 
                             @if (Model.ApprovalItems.Any())
                             {
                                <section class="approval-panel" aria-labelledby="approval-panel-title">
                                    <div class="approval-panel-header">
                                        <div>
                                            <p class="eyebrow">Human gates</p>
                                            <h3 id="approval-panel-title">Approvals</h3>
                                        </div>
                                        @if (Model.HasPendingApprovals)
                                        {
                                            <span class="approval-count pending">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="approval-count resolved">Resolved</span>
                                        }
                                    </div>
                                    <div class="approval-list">
                                        @foreach (var approval in Model.ApprovalItems)
                                        {
                                            <article class="approval-item @(approval.IsPending ? "approval-pending" : "approval-resolved")">
                                                <div class="approval-item-main">
                                                    <div class="approval-item-title-row">
                                                        <h4>@approval.StageTimingLabel</h4>
                                                        <span class="approval-status">@approval.Status</span>
                                                    </div>
                                                    <p>@approval.Reason</p>
                                                    <dl class="approval-meta">
                                                        <div>
                                                            <dt>Role</dt>
                                                            <dd>@approval.RequestedRole</dd>
                                                        </div>
                                                        <div>
                                                            <dt>Resume</dt>
                                                            <dd>@approval.ResumeStageName</dd>
                                                        </div>
                                                        <div>
                                                            <dt>Requested</dt>
                                                            <dd>@approval.CreatedAt.ToLocalTime().ToString("g")</dd>
                                                        </div>
                                                    </dl>
                                                </div>
                                                @if (!approval.IsPending)
                                                {
                                                    <div class="approval-decision">
                                                        <span>Decided by @approval.DecidedBy</span>
                                                        @if (approval.DecidedAt.HasValue)
                                                        {
                                                            <small>@approval.DecidedAt.Value.ToLocalTime().ToString("g")</small>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(approval.DecisionReason))
                                                        {
                                                            <p>@approval.DecisionReason</p>
                                                        }
                                                        @if (approval.IsApproved && !isActive && !isDelivered && !Model.Run.IsRemote && canContinue)
                                                        {
                                                            <form asp-action="ResumeApproval" asp-route-id="@Model.Run.Id" asp-route-approvalId="@approval.Id"
                                                                  method="post" class="approval-resume-form">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-sm btn-success w-100">Resume</button>
                                                            </form>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="approval-actions" aria-label="Approval decision actions">
                                                        <form asp-action="ApproveApproval" asp-route-id="@Model.Run.Id" asp-route-approvalId="@approval.Id"
                                                              method="post" class="approval-action-form">
                                                            @Html.AntiForgeryToken()
                                                            <label class="visually-hidden" for="approve-reason-@approval.Id">Approval note</label>
                                                            <input id="approve-reason-@approval.Id" name="Reason" type="text" maxlength="1000"
                                                                   class="form-control form-control-sm" placeholder="optional note" />
                                                            <button type="submit" class="btn btn-sm btn-success w-100">Approve</button>
                                                        </form>
                                                        <form asp-action="RejectApproval" asp-route-id="@Model.Run.Id" asp-route-approvalId="@approval.Id"
                                                              method="post" class="approval-action-form">
                                                            @Html.AntiForgeryToken()
                                                            <label class="visually-hidden" for="reject-reason-@approval.Id">Rejection note</label>
                                                            <input id="reject-reason-@approval.Id" name="Reason" type="text" maxlength="1000"
                                                                   class="form-control form-control-sm" placeholder="optional note" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">Reject</button>
                                                        </form>
                                                    </div>
                                                }
                                            </article>
                                        }
                                    </div>
                                </section>
                            }

                            @if (Model.HasPolicyItems)
                            {
                                <section class="policy-panel" aria-labelledby="policy-panel-title">
                                    <button class="policy-panel-header collapsed" type="button" data-bs-toggle="collapse"
                                            data-bs-target="#policy-collapse" aria-expanded="false" aria-controls="policy-collapse">
                                        <div>
                                            <p class="eyebrow">Policy</p>
                                            <h3 id="policy-panel-title">Policy Signals</h3>
                                        </div>
                                        <div class="panel-toggle-group">
                                            <span class="policy-count">@Model.PolicyItems.Count</span>
                                            <span class="panel-chevron">&#8964;</span>
                                        </div>
                                    </button>
                                    <div class="collapse" id="policy-collapse">
                                        <div class="policy-list">
                                            @foreach (var policy in Model.PolicyItems)
                                            {
                                                <article class="policy-item policy-kind-@policy.Kind">
                                                    <div class="policy-item-header">
                                                        <span class="policy-kind">@policy.KindLabel</span>
                                                        <span class="policy-stage">@policy.StageLabel</span>
                                                    </div>
                                                    <p>@policy.Summary</p>
                                                </article>
                                            }
                                        </div>
                                    </div>
                                </section>
                            }

                            @if (Model.ArtifactItems.Any())
                            {
                                <section class="evidence-panel" aria-labelledby="artifact-panel-title">
                                    <button class="evidence-panel-header collapsed" type="button" data-bs-toggle="collapse"
                                            data-bs-target="#artifact-collapse" aria-expanded="false" aria-controls="artifact-collapse">
                                        <div>
                                            <p class="eyebrow">Artifact ledger</p>
                                            <h3 id="artifact-panel-title">Artifacts</h3>
                                        </div>
                                        <div class="panel-toggle-group">
                                            <span class="evidence-count">@Model.ArtifactItems.Count</span>
                                            <span class="panel-chevron">&#8964;</span>
                                        </div>
                                    </button>
                                    <div class="collapse" id="artifact-collapse">
                                        <div class="evidence-list">
                                            @foreach (var artifact in Model.ArtifactItems)
                                            {
                                                <article class="evidence-item evidence-kind-stage-artifact">
                                                    <div class="evidence-item-header">
                                                        <span class="evidence-kind">@artifact.Label</span>
                                                        <span class="evidence-stage">@artifact.StageLabel</span>
                                                    </div>
                                                    @if (artifact.HasValue)
                                                    {
                                                        <p>@artifact.Value</p>
                                                    }
                                                    <div class="evidence-meta">
                                                        <span>@artifact.CreatedAt.ToLocalTime().ToString("g")</span>
                                                        @if (!string.IsNullOrWhiteSpace(artifact.ContractVersion))
                                                        {
                                                            <span>contract @artifact.ContractVersion</span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(artifact.MediaType))
                                                        {
                                                            <span>@artifact.MediaType</span>
                                                        }
                                                    </div>
                                                    @if (artifact.HasUri)
                                                    {
                                                        <a class="evidence-link" href="@artifact.Uri" target="_blank" rel="noopener">Open artifact</a>
                                                    }
                                                </article>
                                            }
                                        </div>
                                    </div>
                                </section>
                            }

                            @if (Model.EvidenceItems.Any())
                            {
                                <section class="evidence-panel" aria-labelledby="evidence-panel-title">
                                    <button class="evidence-panel-header collapsed" type="button" data-bs-toggle="collapse"
                                            data-bs-target="#evidence-collapse" aria-expanded="false" aria-controls="evidence-collapse">
                                        <div>
                                            <p class="eyebrow">Evidence ledger</p>
                                            <h3 id="evidence-panel-title">Evidence</h3>
                                        </div>
                                        <div class="panel-toggle-group">
                                            <span class="evidence-count">@Model.EvidenceItems.Count</span>
                                            <span class="panel-chevron">&#8964;</span>
                                        </div>
                                    </button>
                                    <div class="collapse" id="evidence-collapse">
                                        <div class="evidence-list">
                                            @foreach (var evidence in Model.EvidenceItems)
                                            {
                                                <article class="evidence-item evidence-kind-@evidence.Kind">
                                                    <div class="evidence-item-header">
                                                        <span class="evidence-kind">@evidence.KindLabel</span>
                                                        <span class="evidence-stage">@evidence.StageLabel</span>
                                                    </div>
                                                    <h4>@evidence.Name</h4>
                                                    <p>@evidence.Summary</p>
                                                    <div class="evidence-meta">
                                                        <span>@evidence.CreatedAt.ToLocalTime().ToString("g")</span>
                                                        @if (!string.IsNullOrWhiteSpace(evidence.MediaType))
                                                        {
                                                            <span>@evidence.MediaType</span>
                                                        }
                                                    </div>
                                                    @if (evidence.HasUri)
                                                    {
                                                        <a class="evidence-link" href="@evidence.Uri" target="_blank" rel="noopener">Open evidence</a>
                                                    }
                                                </article>
                                            }
                                        </div>
                                    </div>
                                </section>
                            }

                            @if (Model.Run.Status == "Completed" && Model.Run.SkipDeliver)
                            {
                                <div class="delivery-panel" id="delivery-panel">
                                    <div class="delivery-panel-header">
                                        <span class="delivery-icon">🚀</span>
                                        <div>
                                            <h3>Ready for delivery</h3>
                                            <p>All stages passed. Code is ready but has <strong>not been merged</strong> yet.</p>
                                        </div>
                                    </div>
                                    <div class="delivery-panel-body">
                                        <p class="delivery-explainer">Clicking <strong>Deliver Now</strong> will:</p>
                                        <ul>
                                            <li>Merge the approved PR into the target branch</li>
                                            <li>Delete the feature branch</li>
                                            <li>Post the landing report on the issue</li>
                                        </ul>
                                        @if (!string.IsNullOrWhiteSpace(Model.Run.PrUrl))
                                        {
                                            <p><a href="@Model.Run.PrUrl" target="_blank" rel="noopener" class="delivery-pr-link">📋 Review PR before
                                                delivering →</a></p>
                                            }
                                        </div>
                                        <form asp-action="DeliverNow" asp-route-id="@Model.Run.Id" method="post" class="delivery-panel-action">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-warning btn-lg w-100"
                                                    onclick="return confirm('This will merge the PR into the target branch. Proceed?')">
                                                🚀 Deliver Now
                                            </button>
                                            <small class="text-muted mt-1 d-block text-center">This action merges code — it cannot be undone.</small>
                                        </form>
                                    </div>
                                }

                                @* Hidden template for live injection of delivery panel via SignalR *@
                                <template id="delivery-panel-template">
                                    <div class="delivery-panel" id="delivery-panel">
                                        <div class="delivery-panel-header">
                                            <span class="delivery-icon">🚀</span>
                                            <div>
                                                <h3>Ready for delivery</h3>
                                                <p>All stages passed. Code is ready but has <strong>not been merged</strong> yet.</p>
                                            </div>
                                        </div>
                                        <div class="delivery-panel-body">
                                            <p class="delivery-explainer">Clicking <strong>Deliver Now</strong> will:</p>
                                            <ul>
                                                <li>Merge the approved PR into the target branch</li>
                                                <li>Delete the feature branch</li>
                                                <li>Post the landing report on the issue</li>
                                            </ul>
                                        </div>
                                        <form action="/Pipelines/@Model.Run.Id/DeliverNow" method="post" class="delivery-panel-action">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-warning btn-lg w-100"
                                                    onclick="return confirm('This will merge the PR into the target branch. Proceed?')">
                                                🚀 Deliver Now
                                            </button>
                                            <small class="text-muted mt-1 d-block text-center">This action merges code — it cannot be
                                                undone.</small>
                                            </form>
                                        </div>
                                    </template>

                                    <div class="agent-heading">
                                        <div>
                                            <p class="eyebrow">Station telemetry</p>
                                            <h2>Agent activity</h2>
                                        </div>
                                    </div>

                                    <div id="agent-feed" class="agent-station-feed"></div>

                                    <article class="issue-brief" aria-labelledby="issue-brief-title">
                                        <div class="issue-brief-kicker">Mission brief</div>
                                        <h3 id="issue-brief-title">
                                            <a href="@ghIssueUrl" target="_blank" rel="noopener">#@Model.Run.IssueNumber @issueTitle</a>
                                        </h3>
                                        @if (!string.IsNullOrWhiteSpace(issueBody))
                                        {
                                            <p>@issueBody</p>
                                        }
                                        else
                                        {
                                            <p class="muted-cell">Issue details are not available yet. The run will continue using the GitHub issue as its
                                                source of truth.</p>
                                            }
                                        </article>

                                        @if (Model.Labels.Any())
                                        {
                                            <div class="label-row mb-3">
                                                @foreach (var label in Model.Labels)
                                                {
                                                    <span class="badge text-bg-light border">@label</span>
                                                }
                                            </div>
                                        }
                                    </section>

                                    @section Styles {
                                        <link rel="stylesheet" href="~/css/pipeline-details.css" asp-append-version="true" />
                                    }

                                    @section Scripts {
                                        <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
                                        <script id="pipeline-details-bootstrap" type="application/json">@Html.Raw(bootstrapJson)</script>
                                        <script src="~/js/pipeline-details.js" asp-append-version="true"></script>
                                    }
