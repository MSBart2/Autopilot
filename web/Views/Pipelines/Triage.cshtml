@model Cyberpilot.Web.Models.PipelineTriageDocumentViewModel
@{
    ViewData["Title"] = $"Triage - Issue #{Model.Run.IssueNumber}";
    var triage = Model.Triage;
}

<div class="pipeline-detail-shell plan-document-shell">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-action="Index">Pipelines</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Run.Id">Run @Model.Run.Id</a></li>
            <li class="breadcrumb-item active" aria-current="page">Triage</li>
        </ol>
    </nav>

    <main class="plan-document-grid">
        <section class="plan-document-main" aria-labelledby="triage-full-title">
            <div class="plan-document-section-header plan-document-section-header-actions">
                <div>
                    <p class="eyebrow">Captured output</p>
                    <h1 id="triage-full-title">Issue #@Model.Run.IssueNumber Triage</h1>
                </div>
                <div class="plan-review-badges">
                    <a class="btn btn-sm btn-outline-light" href="@Model.IssueUrl" target="_blank" rel="noopener">View issue</a>
                    <a asp-action="Details" asp-route-id="@Model.Run.Id" class="btn btn-sm btn-outline-info">Back to run</a>
                    <span class="plan-review-status">@triage.Status</span>
                    @if (!string.IsNullOrWhiteSpace(triage.Decision) && triage.Decision != "unknown")
                    {
                        <span class="plan-review-decision">@triage.Decision</span>
                    }
                </div>
            </div>
            @if (triage.HasFullTriageText)
            {
                @if (Model.RenderedTriageHtml is not null)
                {
                    <div class="plan-rendered-body markdown-body">
                        @Html.Raw(Model.RenderedTriageHtml)
                    </div>
                }
                else
                {
                    <pre class="plan-document-pre">@triage.FullTriageText</pre>
                }
            }
            else
            {
                <p class="muted-cell">No full triage text was captured for this run.</p>
            }
        </section>

        <aside class="plan-document-aside" aria-label="Triage metadata">
            <section class="plan-document-card">
                <p class="eyebrow">Metadata</p>
                <dl class="plan-review-meta">
                    <div>
                        <dt>Captured</dt>
                        <dd>@triage.CreatedAt.ToLocalTime().ToString("g")</dd>
                    </div>
                    <div>
                        <dt>Contract</dt>
                        <dd>@(string.IsNullOrWhiteSpace(triage.ContractVersion) ? "unknown" : triage.ContractVersion)</dd>
                    </div>
                </dl>
            </section>

            @if (triage.HasRequiredActions)
            {
                <section class="plan-document-card">
                    <p class="eyebrow">Required before continuing</p>
                    <ul class="plan-document-list">
                        @foreach (var action in triage.RequiredActions)
                        {
                            <li>@action</li>
                        }
                    </ul>
                </section>
            }

            @if (triage.HasEvidence)
            {
                <section class="plan-document-card">
                    <p class="eyebrow">Supporting evidence</p>
                    <div class="plan-review-evidence">
                        @foreach (var evidence in triage.Evidence)
                        {
                            <p><strong>@evidence.KindLabel:</strong> @evidence.Summary</p>
                        }
                    </div>
                </section>
            }

        </aside>
    </main>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pipeline-details.css" asp-append-version="true" />
}
