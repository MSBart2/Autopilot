<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cyberpilot</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="site-background" aria-hidden="true"></div>
    <div class="cockpit-frame" aria-hidden="true"></div>
    <header class="site-header command-header">
        <nav class="navbar navbar-expand-sm navbar-dark app-nav command-nav">
            <div class="container-fluid app-container command-nav-inner">
                <a class="navbar-brand brand-lockup" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">AP</span>
                    <span>
                        <span class="brand-name">Cyberpilot</span>
                        <span class="brand-subtitle">Mission Control</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-sm-auto app-nav-links">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Command</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Pipelines" asp-action="Index">Missions</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Pipelines" asp-action="Issues">Dispatch</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="app-container page-shell command-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer command-footer">
        <div class="app-container footer-inner">
            <span>Cyberpilot Mission Control</span>
            <span class="footer-pulse" aria-hidden="true"></span>
        </div>
    </footer>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>